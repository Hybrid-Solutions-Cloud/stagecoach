<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Stagecoach.App.App"
             RequestedThemeVariant="Light">

  <Application.Resources>
    <SolidColorBrush x:Key="StageColorCanvas">#F4F1EA</SolidColorBrush>
    <SolidColorBrush x:Key="StageColorSurface">#FFFDF8</SolidColorBrush>
    <SolidColorBrush x:Key="StageColorSurfaceAlt">#EEE9DF</SolidColorBrush>
    <SolidColorBrush x:Key="StageColorInk">#25231F</SolidColorBrush>
    <SolidColorBrush x:Key="StageColorMuted">#6F6A61</SolidColorBrush>
    <SolidColorBrush x:Key="StageColorLine">#D4CDC0</SolidColorBrush>
    <SolidColorBrush x:Key="StageColorLineStrong">#A99E8D</SolidColorBrush>
    <SolidColorBrush x:Key="StagecoachAccentBrush">#9A412B</SolidColorBrush>
    <SolidColorBrush x:Key="StageColorAccentStrong">#7B3020</SolidColorBrush>
    <SolidColorBrush x:Key="StageColorAccentSoft">#F2DFD8</SolidColorBrush>
    <SolidColorBrush x:Key="StageColorGood">#27715B</SolidColorBrush>
    <SolidColorBrush x:Key="StageColorGoodSoft">#DEEEE8</SolidColorBrush>
    <SolidColorBrush x:Key="StageColorWarning">#A26118</SolidColorBrush>
    <SolidColorBrush x:Key="StageColorWarningSoft">#F7EAD5</SolidColorBrush>
    <SolidColorBrush x:Key="StageColorDanger">#A33E3E</SolidColorBrush>
    <SolidColorBrush x:Key="StageColorDangerSoft">#FBE5E5</SolidColorBrush>
    <SolidColorBrush x:Key="StageColorNavigation">#EEE8DD</SolidColorBrush>
    <SolidColorBrush x:Key="StageColorContext">#E7DFD2</SolidColorBrush>
    <SolidColorBrush x:Key="StageColorHeader">#2C3737</SolidColorBrush>
    <Thickness x:Key="StageCardPadding">16</Thickness>
    <x:Double x:Key="StageFontSize11">11</x:Double>
    <x:Double x:Key="StageFontSize12">12</x:Double>
    <x:Double x:Key="StageFontSize14">14</x:Double>
    <x:Double x:Key="StageFontSize16">16</x:Double>
    <x:Double x:Key="StageFontSize18">18</x:Double>
    <x:Double x:Key="StageFontSize20">20</x:Double>
    <x:Double x:Key="StageFontSize22">22</x:Double>
    <x:Double x:Key="StageFontSize24">24</x:Double>
  </Application.Resources>

  <Application.Styles>
    <!-- Compact density and square, flat surfaces keep the app legible on a laptop and cheap to
         redraw inside an RDP session. Do not add corner radius, gradients, or shadows here. -->
    <FluentTheme DensityStyle="Compact" />

    <Style Selector="Window">
      <Setter Property="FontSize" Value="{DynamicResource StageFontSize14}" />
      <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
      <Setter Property="Foreground" Value="{DynamicResource StageColorInk}" />
      <Setter Property="Background" Value="{DynamicResource StageColorCanvas}" />
    </Style>

    <Style Selector="NumericUpDown">
      <Setter Property="MinHeight" Value="26" />
    </Style>

    <!-- Every visual state is applied to the template's content presenter, not to the Button.
         The Fluent template paints that presenter over the Button's own background, so setting
         Background on the Button alone leaves the theme's own pointerover and disabled brushes in
         charge — which made buttons change colour on hover and never return. -->
    <Style Selector="Button">
      <Setter Property="Background" Value="{DynamicResource StageColorSurface}" />
      <Setter Property="Foreground" Value="{DynamicResource StageColorInk}" />
      <Setter Property="BorderBrush" Value="{DynamicResource StageColorLineStrong}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="Button /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource StageColorSurface}" />
      <Setter Property="Foreground" Value="{DynamicResource StageColorInk}" />
      <Setter Property="BorderBrush" Value="{DynamicResource StageColorLineStrong}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource StageColorAccentSoft}" />
      <Setter Property="Foreground" Value="{DynamicResource StageColorInk}" />
      <Setter Property="BorderBrush" Value="{DynamicResource StageColorLineStrong}" />
    </Style>
    <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource StageColorSurfaceAlt}" />
      <Setter Property="Foreground" Value="{DynamicResource StageColorInk}" />
      <Setter Property="BorderBrush" Value="{DynamicResource StageColorLineStrong}" />
    </Style>
    <!-- A disabled control must still read as a control. The previous washed-out treatment made
         buttons look absent while a background operation held them disabled. -->
    <Style Selector="Button:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource StageColorSurfaceAlt}" />
      <Setter Property="Foreground" Value="#6F6A61" />
      <Setter Property="BorderBrush" Value="{DynamicResource StageColorLineStrong}" />
    </Style>
    <Style Selector="Button:disabled">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="{DynamicResource StagecoachAccentBrush}" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="MinHeight" Value="40" />
      <Setter Property="Padding" Value="18,9" />
      <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="Button.primary /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource StagecoachAccentBrush}" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderBrush" Value="{DynamicResource StagecoachAccentBrush}" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource StageColorAccentStrong}" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderBrush" Value="{DynamicResource StageColorAccentStrong}" />
    </Style>
    <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource StageColorAccentStrong}" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderBrush" Value="{DynamicResource StageColorAccentStrong}" />
    </Style>
    <Style Selector="Button.header-action">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="#86908F" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="#F7FAF9" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Padding" Value="12,7" />
      <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="Button.header-action /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="#86908F" />
      <Setter Property="Foreground" Value="#F7FAF9" />
    </Style>
    <Style Selector="Button.header-action:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#455252" />
      <Setter Property="BorderBrush" Value="#B6C0BF" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.header-action:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#1D2626" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <!-- On the dark header band the shared disabled treatment rendered as an empty rectangle. -->
    <Style Selector="Button.header-action:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#3A4545" />
      <Setter Property="BorderBrush" Value="#5C6665" />
      <Setter Property="Foreground" Value="#9FA9A8" />
    </Style>
    <Style Selector="Button.primary:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#C9A899" />
      <Setter Property="BorderBrush" Value="#C9A899" />
      <Setter Property="Foreground" Value="#FFF6F1" />
    </Style>

    <Style Selector="TextBox">
      <Setter Property="Background" Value="{DynamicResource StageColorSurface}" />
      <Setter Property="Foreground" Value="{DynamicResource StageColorInk}" />
      <Setter Property="BorderBrush" Value="{DynamicResource StageColorLineStrong}" />
      <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="ComboBox">
      <Setter Property="Background" Value="{DynamicResource StageColorSurface}" />
      <Setter Property="Foreground" Value="{DynamicResource StageColorInk}" />
      <Setter Property="BorderBrush" Value="{DynamicResource StageColorLineStrong}" />
      <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="ComboBoxItem">
      <Setter Property="Background" Value="{DynamicResource StageColorSurface}" />
      <Setter Property="Foreground" Value="{DynamicResource StageColorInk}" />
    </Style>
    <Style Selector="ComboBoxItem:pointerover">
      <Setter Property="Background" Value="{DynamicResource StageColorAccentSoft}" />
      <Setter Property="Foreground" Value="{DynamicResource StageColorInk}" />
    </Style>
    <Style Selector="ComboBoxItem:selected">
      <Setter Property="Background" Value="{DynamicResource StagecoachAccentBrush}" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="ListBoxItem">
      <Setter Property="Foreground" Value="{DynamicResource StageColorInk}" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="ListBoxItem:selected">
      <Setter Property="Background" Value="{DynamicResource StageColorAccentSoft}" />
      <Setter Property="Foreground" Value="{DynamicResource StageColorInk}" />
    </Style>

    <!-- Left product navigation. This is what separates a product shell from a tabbed dialog. -->
    <Style Selector="TabControl.product-shell">
      <Setter Property="TabStripPlacement" Value="Left" />
      <Setter Property="Background" Value="{DynamicResource StageColorCanvas}" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="TabControl.product-shell TabItem">
      <Setter Property="MinWidth" Value="210" />
      <Setter Property="MaxWidth" Value="210" />
      <Setter Property="MinHeight" Value="44" />
      <Setter Property="Padding" Value="18,11" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Foreground" Value="{DynamicResource StageColorMuted}" />
      <Setter Property="Background" Value="{DynamicResource StageColorNavigation}" />
      <Setter Property="BorderThickness" Value="5,0,0,0" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="FontSize" Value="{DynamicResource StageFontSize16}" />
    </Style>
    <Style Selector="TabControl.product-shell TabItem:selected">
      <Setter Property="Background" Value="{DynamicResource StagecoachAccentBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource StageColorAccentStrong}" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource StageColorSurface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource StageColorLine}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Padding" Value="{StaticResource StageCardPadding}" />
    </Style>
    <Style Selector="Border.panel">
      <Setter Property="Background" Value="{DynamicResource StageColorSurface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource StageColorLine}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Padding" Value="18" />
    </Style>
    <Style Selector="Border.callout">
      <Setter Property="Background" Value="{DynamicResource StageColorGoodSoft}" />
      <Setter Property="BorderBrush" Value="{DynamicResource StageColorGood}" />
      <Setter Property="BorderThickness" Value="4,0,0,0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Padding" Value="12" />
    </Style>
    <Style Selector="Border.warning">
      <Setter Property="Background" Value="{DynamicResource StageColorWarningSoft}" />
      <Setter Property="BorderBrush" Value="{DynamicResource StageColorWarning}" />
      <Setter Property="BorderThickness" Value="4,0,0,0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Padding" Value="12" />
    </Style>
    <Style Selector="Border.info">
      <Setter Property="Background" Value="#E8F1F7" />
      <Setter Property="BorderBrush" Value="#316B8F" />
      <Setter Property="BorderThickness" Value="4,0,0,0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Padding" Value="12" />
    </Style>

    <Style Selector="TextBlock.screen-eyebrow">
      <Setter Property="Foreground" Value="{DynamicResource StageColorAccentStrong}" />
      <Setter Property="FontSize" Value="{DynamicResource StageFontSize11}" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="LetterSpacing" Value="1.4" />
    </Style>
    <Style Selector="TextBlock.screen-title">
      <Setter Property="FontFamily" Value="Georgia" />
      <Setter Property="FontSize" Value="31" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="#171612" />
    </Style>
    <Style Selector="TextBlock.screen-description">
      <Setter Property="Foreground" Value="{DynamicResource StageColorMuted}" />
      <Setter Property="FontSize" Value="{DynamicResource StageFontSize16}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.section-title">
      <Setter Property="FontSize" Value="{DynamicResource StageFontSize18}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.field-label">
      <Setter Property="FontSize" Value="{DynamicResource StageFontSize12}" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="TextBlock.column-header">
      <Setter Property="FontSize" Value="{DynamicResource StageFontSize11}" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="{DynamicResource StageColorMuted}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="TextBox.estate-search">
      <Setter Property="MinHeight" Value="52" />
      <Setter Property="FontSize" Value="{DynamicResource StageFontSize16}" />
      <Setter Property="Padding" Value="16,12" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="BorderBrush" Value="{DynamicResource StageColorLineStrong}" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="Background" Value="{DynamicResource StageColorSurface}" />
    </Style>
    <Style Selector="ComboBox.estate-filter">
      <Setter Property="MinHeight" Value="40" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="ListBox.estate-list">
      <Setter Property="Background" Value="{DynamicResource StageColorSurface}" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
  </Application.Styles>
</Application>
