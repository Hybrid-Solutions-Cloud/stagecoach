<Window x:Class="Stagecoach.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Stagecoach — Desktop Command Center" Height="780" Width="1240"
        Background="#090D16" Foreground="#F8FAFC"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar Navigation -->
        <Border Grid.Column="0" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="0,0,1,0">
            <DockPanel LastChildFill="True">
                <!-- Brand Header -->
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="20,20,20,24">
                    <TextBlock Text="STAGECOACH" FontSize="18" FontWeight="ExtraBold" Foreground="#F97316" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Navigation Tabs -->
                <StackPanel DockPanel.Dock="Top" Margin="0,10,0,0">
                    <Button Content="🖥️  Estate" Height="44" HorizontalContentAlignment="Left" Padding="20,0"
                            Background="#1E293B" BorderThickness="0" Foreground="#F8FAFC" FontSize="14" FontWeight="SemiBold"
                            Command="{Binding SelectTabCommand}" CommandParameter="Estate" Cursor="Hand"/>
                    <Button Content="👤  Identities &amp; Sync" Height="44" HorizontalContentAlignment="Left" Padding="20,0"
                            Background="Transparent" BorderThickness="0" Foreground="#94A3B8" FontSize="14" FontWeight="SemiBold"
                            Command="{Binding SelectTabCommand}" CommandParameter="Identities" Cursor="Hand"/>
                    <Button Content="⚡  Sessions &amp; Recents" Height="44" HorizontalContentAlignment="Left" Padding="20,0"
                            Background="Transparent" BorderThickness="0" Foreground="#94A3B8" FontSize="14" FontWeight="SemiBold"
                            Command="{Binding SelectTabCommand}" CommandParameter="Sessions" Cursor="Hand"/>
                </StackPanel>

                <!-- Bottom Info -->
                <TextBlock DockPanel.Dock="Bottom" Text="v1.0 Desktop • .NET 9" Foreground="#64748B" FontSize="11" Margin="20"/>
                <Grid/>
            </DockPanel>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Top Header Bar -->
            <Border Grid.Row="0" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="0,0,0,1" Padding="24,0">
                <DockPanel LastChildFill="False">
                    <TextBlock Text="{Binding StatusMessage}" Foreground="#94A3B8" FontSize="13" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                        <Button Content="↻ Sync Estate" Command="{Binding SyncEstateCommand}"
                                Background="#F97316" Foreground="White" FontWeight="Bold" Padding="14,7" BorderThickness="0" Cursor="Hand"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Estate View -->
            <Grid Grid.Row="1" Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Search & Filter Bar -->
                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="180"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                             Background="#1E293B" Foreground="White" BorderBrush="#334155" Padding="10,8" FontSize="13" Margin="0,0,12,0"/>
                    <ComboBox Grid.Column="1" SelectedValue="{Binding SelectedDomainFilter}" SelectedValuePath="Tag" Background="#1E293B" Foreground="White" Padding="8,6">
                        <ComboBoxItem Content="All Identity Types" Tag="ALL" IsSelected="True"/>
                        <ComboBoxItem Content="Active Directory" Tag="ActiveDirectory"/>
                        <ComboBoxItem Content="Workgroup" Tag="Workgroup"/>
                        <ComboBoxItem Content="Entra ID" Tag="EntraID"/>
                    </ComboBox>
                </Grid>

                <!-- Inventory DataGrid -->
                <DataGrid Grid.Row="1" ItemsSource="{Binding FilteredMachines}" AutoGenerateColumns="False" 
                          Background="#0F172A" RowBackground="#0F172A" AlternatingRowBackground="#151E33" 
                          Foreground="#F8FAFC" BorderBrush="#1E293B" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#1E293B"
                          HeadersVisibility="Column" CanUserAddRows="False" IsReadOnly="True" SelectionMode="Single">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#0B1120"/>
                            <Setter Property="Foreground" Value="#94A3B8"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Padding" Value="12,10"/>
                            <Setter Property="BorderThickness" Value="0"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="★" Width="40">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="★" Background="Transparent" BorderThickness="0" Foreground="#FACC15"
                                            Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}" Cursor="Hand"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Target Name" Binding="{Binding Name}" FontWeight="Bold" Width="180"/>
                        <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="110"/>
                        <DataGridTextColumn Header="OS" Binding="{Binding OsName}" Width="160"/>
                        <DataGridTextColumn Header="Domain / Identity" Binding="{Binding DomainName}" Width="180"/>
                        <DataGridTextColumn Header="Power" Binding="{Binding PowerState}" Width="100"/>
                        <DataGridTemplateColumn Header="Action" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Connect" Background="#F97316" Foreground="White" FontWeight="SemiBold" Padding="10,4" BorderThickness="0"
                                            Command="{Binding DataContext.OpenConnectDrawerCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}" Cursor="Hand"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Grid>

        <!-- Slide-Over Connect Drawer (Column 2) -->
        <Border Grid.Column="2" Width="380" Background="#0F172A" BorderBrush="#334155" BorderThickness="1,0,0,0" Padding="24"
                Visibility="{Binding IsDrawerOpen, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <DockPanel LastChildFill="False" Margin="0,0,0,20">
                    <TextBlock Text="Connect to VM" FontSize="18" FontWeight="Bold" Foreground="White" DockPanel.Dock="Left"/>
                    <Button Content="✕" Background="Transparent" Foreground="#94A3B8" BorderThickness="0" FontSize="16" DockPanel.Dock="Right"
                            Command="{Binding CloseDrawerCommand}" Cursor="Hand"/>
                </DockPanel>

                <TextBlock Text="Machine Name" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,4"/>
                <TextBlock Text="{Binding SelectedMachine.Name}" FontSize="16" FontWeight="Bold" Foreground="#F97316" Margin="0,0,0,16"/>

                <TextBlock Text="Domain / Identity Status" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,4"/>
                <TextBlock Text="{Binding SelectedMachine.DomainName}" FontSize="14" Foreground="#38BDF8" Margin="0,0,0,16"/>

                <TextBlock Text="Target Account" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,4"/>
                <TextBox Text="{Binding TargetUsername, UpdateSourceTrigger=PropertyChanged}" Background="#1E293B" Foreground="White" BorderBrush="#334155" Padding="8" Margin="0,0,0,16"/>

                <TextBlock Text="Credential Status" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,4"/>
                <TextBlock Text="{Binding CredentialStatusText}" Foreground="#4ADE80" FontSize="13" Margin="0,0,0,16"/>

                <TextBlock Text="Local Admin Password (Optional)" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,4"/>
                <TextBox Text="{Binding TargetPassword, UpdateSourceTrigger=PropertyChanged}" Background="#1E293B" Foreground="White" BorderBrush="#334155" Padding="8" Margin="0,0,0,8"/>
                <CheckBox Content="Save to Key Vault (kv-hcs-vault-01)" IsChecked="{Binding SaveToKeyVault}" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,24"/>

                <Button Content="Launch 1-Click RDP (MSTSC)" Command="{Binding LaunchConnectionCommand}" 
                        Background="#F97316" Foreground="White" FontWeight="Bold" FontSize="14" Padding="16,10" BorderThickness="0" Cursor="Hand"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
