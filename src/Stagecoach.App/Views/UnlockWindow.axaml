<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Stagecoach.App.Views.UnlockWindow"
        Title="Unlock Stagecoach"
        Width="560" Height="420" MinWidth="330" MinHeight="300"
        WindowStartupLocation="CenterScreen">
  <Grid RowDefinitions="Auto,*" Background="{DynamicResource StageColorCanvas}">
    <Border Grid.Row="0" Background="{DynamicResource StageColorHeader}" Padding="20,14">
      <StackPanel Orientation="Horizontal" Spacing="12">
        <Border Width="38" Height="38" Background="{DynamicResource StagecoachAccentBrush}">
          <TextBlock Text="S" FontSize="21" FontWeight="Bold" Foreground="White"
                     HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="Stagecoach" Foreground="White"
                     FontSize="{StaticResource StageFontSize18}" FontWeight="SemiBold" />
          <TextBlock Text="Locked" Foreground="#AEB9B5" FontSize="{StaticResource StageFontSize11}" />
        </StackPanel>
      </StackPanel>
    </Border>

    <ScrollViewer Grid.Row="1">
      <StackPanel Margin="26,20" Spacing="14">
        <StackPanel Spacing="4">
          <TextBlock Classes="screen-eyebrow" Text="SECURE UNLOCK" />
          <TextBlock x:Name="OwnerText" FontSize="{StaticResource StageFontSize20}" FontWeight="SemiBold"
                     TextWrapping="Wrap" />
          <TextBlock x:Name="MethodText" Classes="screen-description"
                     FontSize="{StaticResource StageFontSize12}" TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Spacing="10">
          <Button x:Name="VerifyButton" Classes="primary" Content="Verify with Windows"
                  HorizontalAlignment="Stretch" IsDefault="True" />
          <TextBlock x:Name="VerifyStatus" TextWrapping="Wrap"
                     Foreground="{DynamicResource StageColorMuted}" IsVisible="False" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button x:Name="QuitButton" Content="Quit" />
          <Button x:Name="ResetButton" Content="Start fresh" />
        </StackPanel>

        <TextBlock FontSize="{StaticResource StageFontSize11}" Opacity="0.7" TextWrapping="Wrap"
                   Text="Start fresh removes the local estate and the owner on this machine so setup can run again. Nothing in Azure is changed." />
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Window>
