<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Stagecoach.App.Views.UnlockWindow"
        Title="Unlock Stagecoach"
        Width="520" Height="360" MinWidth="320" MinHeight="300"
        CanResize="False"
        WindowStartupLocation="CenterScreen">
  <Grid RowDefinitions="Auto,*" Background="{DynamicResource StageColorCanvas}">
    <Border Grid.Row="0" Background="{DynamicResource StageColorHeader}" Padding="20,14">
      <StackPanel Orientation="Horizontal" Spacing="12">
        <Border Width="38" Height="38" Background="{DynamicResource StagecoachAccentBrush}">
          <TextBlock Text="S" FontSize="21" FontWeight="Bold" Foreground="White"
                     HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="Stagecoach" Foreground="White"
                     FontSize="{StaticResource StageFontSize18}" FontWeight="SemiBold" />
          <TextBlock Text="Locked" Foreground="#AEB9B5" FontSize="{StaticResource StageFontSize11}" />
        </StackPanel>
      </StackPanel>
    </Border>

    <StackPanel Grid.Row="1" Margin="26,22" Spacing="12">
      <TextBlock Classes="screen-eyebrow" Text="SECURE UNLOCK" />
      <TextBlock Text="Enter your passphrase" FontSize="{StaticResource StageFontSize20}" FontWeight="SemiBold" />
      <TextBlock TextWrapping="Wrap" Classes="screen-description" FontSize="{StaticResource StageFontSize12}"
                 Text="Your passphrase unwraps the key to the local estate database. It is never stored, and there is no way to recover it." />
      <TextBox x:Name="PassphraseBox" PasswordChar="●" MinHeight="40"
               AutomationProperties.Name="Unlock passphrase" />
      <TextBlock x:Name="ErrorText" Foreground="{DynamicResource StageColorDanger}"
                 TextWrapping="Wrap" IsVisible="False" />
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button x:Name="UnlockButton" Classes="primary" Content="Unlock" IsDefault="True" />
        <Button x:Name="QuitButton" Content="Quit" />
      </StackPanel>
    </StackPanel>
  </Grid>
</Window>
