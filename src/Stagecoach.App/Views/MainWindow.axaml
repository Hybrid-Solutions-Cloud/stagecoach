<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Stagecoach.App.ViewModels"
        xmlns:conv="using:Avalonia.Data.Converters"
        x:Class="Stagecoach.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Stagecoach"
        Width="1400" Height="860" MinWidth="320" MinHeight="300"
        WindowStartupLocation="CenterScreen">

  <!-- Row 0 header band, row 1 actionable error, row 2 content, row 3 status bar.
       Min size stays small so the window fits a laptop and a windowed RDP session. -->
  <Grid RowDefinitions="Auto,Auto,*,Auto" Background="{DynamicResource StageColorCanvas}">

    <Border Grid.Row="0" Background="{DynamicResource StageColorHeader}">
      <Grid RowDefinitions="Auto,Auto">
        <Grid ColumnDefinitions="*,Auto" Margin="18,10" ColumnSpacing="16">
          <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
            <Border Width="38" Height="38" Background="{DynamicResource StagecoachAccentBrush}">
              <TextBlock Text="S" FontSize="21" FontWeight="Bold" Foreground="White"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel>
              <TextBlock Text="Stagecoach" Foreground="White"
                         FontSize="{StaticResource StageFontSize18}" FontWeight="SemiBold" />
              <TextBlock Text="One identity hub. Every reachable machine. One click."
                         Foreground="#AEB9B5" FontSize="{StaticResource StageFontSize11}" />
            </StackPanel>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <Border BorderBrush="#667170" BorderThickness="1" Padding="12,7">
              <TextBlock Text="READ-ONLY DISCOVERY · LOCAL STATE" Foreground="#E7ECEA"
                         FontSize="{StaticResource StageFontSize11}" FontWeight="SemiBold" />
            </Border>
            <Button Classes="header-action" Content="⚡  Quick connect"
                    Command="{Binding OpenQuickConnectCommand}" IsEnabled="{Binding !IsBusy}"
                    AutomationProperties.Name="Connect to a machine once without saving anything" />
            <Button Classes="header-action" Content="↻  Sync estate"
                    Command="{Binding SyncEstateCommand}" IsEnabled="{Binding !IsBusy}"
                    AutomationProperties.Name="Sync the Azure estate" />
          </StackPanel>
        </Grid>

        <!-- Which Entra account is live is never a mystery. -->
        <Border Grid.Row="1" Background="{DynamicResource StageColorContext}"
                BorderBrush="{DynamicResource StageColorLine}" BorderThickness="0,1,0,0" Padding="20,9">
          <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="16">
            <!-- This is the Entra account currently selected for discovery, not a sign-in to
                 Stagecoach itself. Labelling it "active account" read as an application login and
                 misrepresented where the security boundary actually is. -->
            <TextBlock Text="DISCOVERING AS" Foreground="{DynamicResource StageColorMuted}"
                       FontSize="{StaticResource StageFontSize11}" FontWeight="Bold" VerticalAlignment="Center"
                       ToolTip.Tip="The connected Entra account whose scope you are viewing. Stagecoach itself is protected by your Windows sign-in." />
            <Border Grid.Column="1" Background="{DynamicResource StageColorSurface}"
                    BorderBrush="{DynamicResource StageColorLineStrong}" BorderThickness="1" Padding="10,6">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Border Width="7" Background="#1A9B83" />
                <TextBlock Text="{Binding ActiveIdentityContext}" FontWeight="SemiBold" VerticalAlignment="Center" />
              </StackPanel>
            </Border>
            <Border Grid.Column="3" Background="{DynamicResource StageColorGoodSoft}"
                    BorderBrush="{DynamicResource StageColorGood}" BorderThickness="1" Padding="10,5"
                    IsVisible="{Binding HasMachines}">
              <TextBlock Text="{Binding EstateSummary}" Foreground="{DynamicResource StageColorGood}"
                         FontSize="{StaticResource StageFontSize11}" FontWeight="Bold" />
            </Border>
          </Grid>
        </Border>
      </Grid>
    </Border>

    <Border Grid.Row="1" IsVisible="{Binding HasActionableError}" Background="{DynamicResource StageColorDangerSoft}"
            BorderBrush="{DynamicResource StageColorDanger}" BorderThickness="4,0,0,0" Margin="18,12,18,0" Padding="14"
            AutomationProperties.LiveSetting="Assertive">
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
        <TextBlock Text="!" FontSize="{StaticResource StageFontSize22}" FontWeight="Bold"
                   Foreground="{DynamicResource StageColorDanger}" />
        <StackPanel Grid.Column="1" Spacing="4">
          <TextBlock Text="{Binding ErrorTitle}" FontSize="{StaticResource StageFontSize16}" FontWeight="SemiBold" />
          <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
        </StackPanel>
        <Button Grid.Column="2" Content="Dismiss" Command="{Binding DismissErrorCommand}" VerticalAlignment="Top" />
      </Grid>
    </Border>

    <TabControl Grid.Row="2" Classes="product-shell" SelectedIndex="{Binding SelectedTabIndex}">

      <!-- ============================================================ MACHINES: the landing screen -->
      <TabItem Header="▤  Machines">
        <Grid>
          <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="30,24,30,20" Spacing="14">

              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="24">
                <StackPanel Spacing="6">
                  <TextBlock Classes="screen-eyebrow" Text="AZURE ESTATE" />
                  <TextBlock Classes="screen-title" Text="Pick a machine" />
                  <TextBlock Classes="screen-description"
                             Text="Every Azure VM, Azure Arc server, and Azure Local machine your connected accounts can reach. Selecting one connects it." />
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                  <TextBlock Text="{Binding EstateSummary}" Foreground="{DynamicResource StageColorGood}"
                             FontSize="{StaticResource StageFontSize16}" FontWeight="Bold" HorizontalAlignment="Right" />
                  <TextBlock Text="{Binding WorkstationStatus}" Foreground="{DynamicResource StageColorMuted}"
                             FontSize="{StaticResource StageFontSize11}" HorizontalAlignment="Right"
                             TextTrimming="CharacterEllipsis" MaxWidth="360" />
                </StackPanel>
              </Grid>

              <!-- First run. Landing on an empty list with no next step is what an operator hit
                   before; this states the three steps and does the first one in place. -->
              <Border Classes="panel" IsVisible="{Binding IsFirstRun}">
                <StackPanel Spacing="14">
                  <StackPanel Spacing="6">
                    <TextBlock Classes="screen-eyebrow" Text="FIRST-RUN SETUP" />
                    <TextBlock Text="Start by connecting a Microsoft Entra account"
                               FontSize="{StaticResource StageFontSize20}" FontWeight="SemiBold" />
                    <TextBlock Classes="screen-description" MaxWidth="720" HorizontalAlignment="Left"
                               Text="Stagecoach signs you in with Microsoft and then lists the machines that account can reach. It never asks for or stores your Microsoft password." />
                  </StackPanel>

                  <Grid ColumnDefinitions="*,*,*" ColumnSpacing="0">
                    <Border BorderBrush="{DynamicResource StagecoachAccentBrush}" BorderThickness="0,3,0,0" Padding="12">
                      <StackPanel Orientation="Horizontal" Spacing="9">
                        <Border Width="26" Height="26" Background="{DynamicResource StagecoachAccentBrush}">
                          <TextBlock Text="{Binding SetupAccountMarker}" Foreground="White"
                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel>
                          <TextBlock Text="Connect an account" FontWeight="Bold" />
                          <TextBlock Text="{Binding SetupAccountStatus}" FontSize="{StaticResource StageFontSize11}"
                                     Foreground="{DynamicResource StageColorMuted}" />
                        </StackPanel>
                      </StackPanel>
                    </Border>
                    <Border Grid.Column="1" BorderBrush="{DynamicResource StageColorLine}" BorderThickness="0,3,0,0" Padding="12">
                      <StackPanel Orientation="Horizontal" Spacing="9">
                        <Border Width="26" Height="26" Background="{DynamicResource StageColorSurfaceAlt}">
                          <TextBlock Text="{Binding SetupScopeMarker}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel>
                          <TextBlock Text="Include subscriptions" FontWeight="Bold"
                                     Foreground="{DynamicResource StageColorMuted}" />
                          <TextBlock Text="{Binding SetupScopeStatus}" FontSize="{StaticResource StageFontSize11}"
                                     Foreground="{DynamicResource StageColorMuted}" />
                        </StackPanel>
                      </StackPanel>
                    </Border>
                    <Border Grid.Column="2" BorderBrush="{DynamicResource StageColorLine}" BorderThickness="0,3,0,0" Padding="12">
                      <StackPanel Orientation="Horizontal" Spacing="9">
                        <Border Width="26" Height="26" Background="{DynamicResource StageColorSurfaceAlt}">
                          <TextBlock Text="{Binding SetupScanMarker}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel>
                          <TextBlock Text="Scan for machines" FontWeight="Bold"
                                     Foreground="{DynamicResource StageColorMuted}" />
                          <TextBlock Text="{Binding SetupScanStatus}" FontSize="{StaticResource StageFontSize11}"
                                     Foreground="{DynamicResource StageColorMuted}" />
                        </StackPanel>
                      </StackPanel>
                    </Border>
                  </Grid>

                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button Classes="primary" Content="Sign in with Microsoft"
                            Command="{Binding AddWindowsAccountCommand}" IsEnabled="{Binding !IsBusy}"
                            AutomationProperties.Name="Sign in with a Microsoft Entra account" />
                    <Button Content="Sign in with a device code"
                            Command="{Binding AddDeviceCodeAccountCommand}" IsEnabled="{Binding !IsBusy}" />
                    <Button Content="Open Connect identities" Command="{Binding GoToConnectIdentitiesCommand}" />
                  </StackPanel>
                  <TextBlock Classes="screen-description" MaxWidth="760" HorizontalAlignment="Left"
                             FontSize="{StaticResource StageFontSize12}"
                             Text="Your Windows sign-in does not have to be a Microsoft Entra account. Microsoft's own sign-in window lets you type any work or school account you have access to. Use device code when no sign-in window can be shown — for example over a remote session." />
                </StackPanel>
              </Border>
              <Border Classes="panel" IsVisible="{Binding HasIdentities}">
                <StackPanel Spacing="10">
                  <TextBox Classes="estate-search" Text="{Binding SearchText}"
                           PlaceholderText="Search machines, resource groups, domains, tenants, or subscriptions"
                           AutomationProperties.Name="Search machines" />
                  <WrapPanel Orientation="Horizontal">
                    <CheckBox Content="Favorites" IsChecked="{Binding FavoritesOnly}" Margin="0,0,14,6" />
                    <CheckBox Content="Ready only" IsChecked="{Binding ReadyOnly}" Margin="0,0,14,6" />
                    <CheckBox Content="Pinned account" IsChecked="{Binding PinnedOnly}" Margin="0,0,14,6" />
                  </WrapPanel>
                  <Grid ColumnDefinitions="*,*,*,*,Auto" ColumnSpacing="10" RowSpacing="8">
                    <StackPanel Spacing="4">
                      <TextBlock Classes="field-label" Text="Tenant" />
                      <ComboBox Classes="estate-filter" ItemsSource="{Binding TenantFilters}"
                                SelectedItem="{Binding SelectedTenantFilter}"
                                AutomationProperties.Name="Tenant filter" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="4">
                      <TextBlock Classes="field-label" Text="Subscription" />
                      <ComboBox Classes="estate-filter" ItemsSource="{Binding SubscriptionFilters}"
                                SelectedItem="{Binding SelectedSubscriptionFilter}"
                                AutomationProperties.Name="Subscription filter" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="4">
                      <TextBlock Classes="field-label" Text="Source" />
                      <ComboBox Classes="estate-filter" ItemsSource="{Binding SourceFilters}"
                                SelectedItem="{Binding SelectedSourceFilter}"
                                AutomationProperties.Name="Source filter" />
                    </StackPanel>
                    <StackPanel Grid.Column="3" Spacing="4">
                      <TextBlock Classes="field-label" Text="OS" />
                      <ComboBox Classes="estate-filter" ItemsSource="{Binding OperatingSystemFilters}"
                                SelectedItem="{Binding SelectedOperatingSystemFilter}"
                                AutomationProperties.Name="Operating system filter" />
                    </StackPanel>
                    <StackPanel Grid.Column="4" Spacing="4">
                      <TextBlock Classes="field-label" Text="State" />
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <ComboBox Classes="estate-filter" MinWidth="130" ItemsSource="{Binding StateFilters}"
                                  SelectedItem="{Binding SelectedStateFilter}"
                                  AutomationProperties.Name="Power state filter" />
                        <Button Content="Reset" MinHeight="40" Command="{Binding ResetFiltersCommand}" />
                      </StackPanel>
                    </StackPanel>
                  </Grid>
                </StackPanel>
              </Border>

              <Border Classes="panel" Padding="0" IsVisible="{Binding HasMachines}">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                  <Grid RowDefinitions="Auto,*" MinWidth="1020">
                    <!-- Header and rows share one column definition so they always line up. -->
                    <Grid Grid.Row="0" ColumnDefinitions="36,2*,80,90,150,150,120,130,90,190"
                          Margin="8,8,8,6" Background="{DynamicResource StageColorSurfaceAlt}">
                      <TextBlock Classes="column-header" Text="" />
                      <TextBlock Grid.Column="1" Classes="column-header" Text="MACHINE" Margin="6,8" />
                      <TextBlock Grid.Column="2" Classes="column-header" Text="SOURCE" Margin="6,8" />
                      <TextBlock Grid.Column="3" Classes="column-header" Text="OS" Margin="6,8" />
                      <TextBlock Grid.Column="4" Classes="column-header" Text="TENANT" Margin="6,8" />
                      <TextBlock Grid.Column="5" Classes="column-header" Text="SUBSCRIPTION" Margin="6,8" />
                      <TextBlock Grid.Column="6" Classes="column-header" Text="STATE" Margin="6,8" />
                      <TextBlock Grid.Column="7" Classes="column-header" Text="ROUTE" Margin="6,8" />
                      <TextBlock Grid.Column="8" Classes="column-header" Text="ACCOUNT" Margin="6,8" />
                      <TextBlock Grid.Column="9" Classes="column-header" Text="" Margin="6,8" />
                    </Grid>
                    <!-- No height cap and no scrolling of its own: the list grows to its content and
                         the page's scroll viewer moves the whole screen. A capped list inside a
                         scrolling page produced two nested scroll regions, and on a short window
                         the table was clipped to a single visible row. -->
                    <ListBox Grid.Row="1" Classes="estate-list"
                             ItemsSource="{Binding Machines}" SelectedItem="{Binding SelectedMachine}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled"
                             AutomationProperties.Name="Discovered machines">
                      <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:MachineRow">
                          <Grid ColumnDefinitions="36,2*,80,90,150,150,120,130,90,190" Margin="6,6">
                            <Button Content="{Binding Favorite}" Padding="4,2" BorderThickness="0"
                                    Background="Transparent" Foreground="#E3A008"
                                    Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).ToggleFavoriteCommand}"
                                    CommandParameter="{Binding}"
                                    AutomationProperties.Name="Toggle favorite" />
                            <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="6,0" />
                            <TextBlock Grid.Column="2" Text="{Binding Source}" VerticalAlignment="Center" Margin="6,0" />
                            <TextBlock Grid.Column="3" Text="{Binding OperatingSystem}" VerticalAlignment="Center" Margin="6,0" />
                            <TextBlock Grid.Column="4" Text="{Binding Tenant}" TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" Margin="6,0" />
                            <TextBlock Grid.Column="5" Text="{Binding Subscription}" TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" Margin="6,0" />
                            <TextBlock Grid.Column="6" Text="{Binding State}" VerticalAlignment="Center" Margin="6,0" />
                            <TextBlock Grid.Column="7" Text="{Binding Route}" VerticalAlignment="Center" Margin="6,0" />
                            <TextBlock Grid.Column="8" Text="{Binding Account}" VerticalAlignment="Center" Margin="6,0"
                                       FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <StackPanel Grid.Column="9" Orientation="Horizontal" Spacing="6" Margin="6,0">
                              <Button Classes="primary" Content="Connect" MinHeight="30" Padding="14,5"
                                      Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).ConnectCommand}"
                                      CommandParameter="{Binding}"
                                      AutomationProperties.Name="Connect to this machine" />
                              <Button Content="Edit" MinHeight="30" Padding="12,5"
                                      Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).EditMachineCommand}"
                                      CommandParameter="{Binding}"
                                      AutomationProperties.Name="Edit this machine" />
                            </StackPanel>
                          </Grid>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                  </Grid>
                </ScrollViewer>
              </Border>


              <Border Classes="panel" IsVisible="{Binding SelectedMachine, Converter={x:Static conv:ObjectConverters.IsNotNull}}">
                <StackPanel Spacing="8">
                  <TextBlock Classes="screen-eyebrow" Text="SELECTED MACHINE" />
                  <TextBlock Text="{Binding SelectedMachine.Name}" FontSize="{StaticResource StageFontSize20}" />
                  <TextBlock Text="{Binding SelectedMachine.Tenant, StringFormat='Tenant  {0}'}" Opacity="0.75" />
                  <TextBlock Text="{Binding SelectedMachine.Subscription, StringFormat='Subscription  {0}'}" Opacity="0.75" />
                  <TextBlock Text="{Binding SelectedMachine.Route, StringFormat='Route  {0}'}" Opacity="0.75" />
                  <TextBlock Text="{Binding SelectedMachine.Account, StringFormat='Local account  {0}'}" Opacity="0.75" />
                  <TextBlock Text="{Binding SelectedMachine.SignInKind, StringFormat='Windows sign-in  {0}'}"
                             Opacity="0.75" TextWrapping="Wrap" />
                  <Border Classes="callout" IsVisible="{Binding SelectedMachine.IsReady}">
                    <TextBlock Text="{Binding SelectedMachine.ReasonText}" TextWrapping="Wrap" />
                  </Border>
                  <Border Classes="warning" IsVisible="{Binding !SelectedMachine.IsReady}">
                    <TextBlock Text="{Binding SelectedMachine.ReasonText}" TextWrapping="Wrap" />
                  </Border>
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Classes="primary" Content="Connect"
                            Command="{Binding ConnectCommand}" CommandParameter="{Binding SelectedMachine}" />
                    <Button Content="Edit / pin account"
                            Command="{Binding EditMachineCommand}" CommandParameter="{Binding SelectedMachine}" />
                    <Button Content="Prepare Arc OpenSSH"
                            Command="{Binding PreviewArcRemediationCommand}" CommandParameter="{Binding SelectedMachine}" />
                  </StackPanel>
                </StackPanel>
              </Border>

              <Border Classes="warning" IsVisible="{Binding PendingRemediation, Converter={x:Static conv:ObjectConverters.IsNotNull}}">
                <StackPanel Spacing="8">
                  <TextBlock Text="Pending Azure write" FontSize="{StaticResource StageFontSize18}" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding PendingRemediation.Title}" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding PendingRemediation.Description}" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding PendingRemediation.TargetResourceId, StringFormat='Target  {0}'}" TextWrapping="Wrap" />
                  <ItemsControl ItemsSource="{Binding PendingRemediation.SafeOperations}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding}" FontFamily="Consolas" TextWrapping="Wrap" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Classes="primary" Content="Apply approved change" Command="{Binding ApplyArcRemediationCommand}" />
                    <Button Content="Cancel" Command="{Binding CancelRemediationCommand}" />
                  </StackPanel>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>

          <!-- Account picker. Shown only for an unpinned machine, and only ever a choice from the
               stored list — credentials are never typed at connect time. -->
          <Border IsVisible="{Binding IsAccountPickerOpen}" Background="#B325231F">
            <Border Classes="panel" MaxWidth="520" VerticalAlignment="Center" HorizontalAlignment="Center">
              <StackPanel Spacing="12">
                <TextBlock Classes="screen-eyebrow" Text="LOCAL ACCOUNT" />
                <TextBlock Text="{Binding PickerMachine.Name, StringFormat='Which local account for {0}?'}"
                           FontSize="{StaticResource StageFontSize20}" TextWrapping="Wrap" />
                <ComboBox HorizontalAlignment="Stretch" MinHeight="40"
                          ItemsSource="{Binding LocalAccounts}" SelectedItem="{Binding PickerAccount}"
                          AutomationProperties.Name="Local account to use" />
                <CheckBox Content="Remember this for the machine" IsChecked="{Binding PickerRemember}" />
                <TextBlock Text="Arc machines use this one account for both the SSH relay and the Remote Desktop sign-in."
                           FontSize="{StaticResource StageFontSize11}" Opacity="0.75" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Classes="primary" Content="Connect" Command="{Binding ConfirmAccountPickCommand}" />
                  <Button Content="Cancel" Command="{Binding CancelAccountPickCommand}" />
                </StackPanel>
              </StackPanel>
            </Border>
          </Border>

          <!-- Per-machine editor: pin an account up front so this machine never asks again. -->
          <Border IsVisible="{Binding IsMachineEditorOpen}" Background="#B325231F">
            <Border Classes="panel" MaxWidth="560" VerticalAlignment="Center" HorizontalAlignment="Center">
              <StackPanel Spacing="12">
                <TextBlock Classes="screen-eyebrow" Text="EDIT MACHINE" />
                <TextBlock Text="{Binding EditorMachine.Name}" FontSize="{StaticResource StageFontSize20}" />
                <StackPanel Spacing="4">
                  <TextBlock Classes="field-label" Text="Pinned local account" />
                  <ComboBox HorizontalAlignment="Stretch" MinHeight="40"
                            ItemsSource="{Binding LocalAccounts}" SelectedItem="{Binding EditorAccount}"
                            AutomationProperties.Name="Pinned local account" />
                  <TextBlock Text="Leave empty to be asked once at the next connection."
                             FontSize="{StaticResource StageFontSize11}" Opacity="0.75" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Spacing="4">
                  <TextBlock Classes="field-label" Text="Route override" />
                  <ComboBox HorizontalAlignment="Stretch" MinHeight="40"
                            ItemsSource="{Binding EditorMachine.Paths}" SelectedItem="{Binding EditorRoute}"
                            AutomationProperties.Name="Route override" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Classes="primary" Content="Save" Command="{Binding SaveMachineEditCommand}" />
                  <Button Content="Cancel" Command="{Binding CancelMachineEditCommand}" />
                </StackPanel>
              </StackPanel>
            </Border>
          </Border>
        </Grid>
      </TabItem>

      <!-- ============================================================ CONNECT IDENTITIES (Entra) -->
      <TabItem Header="◎  Connect identities">
        <ScrollViewer>
          <StackPanel Margin="30,24,30,20" Spacing="14">
            <StackPanel Spacing="6">
              <TextBlock Classes="screen-eyebrow" Text="FIRST-RUN SETUP" />
              <TextBlock Classes="screen-title" Text="Connect the accounts you use" />
              <TextBlock Classes="screen-description"
                         Text="Each Entra account gets its own isolated, Windows-encrypted Azure CLI session. Your default Azure CLI profile is never touched." />
            </StackPanel>

            <Grid ColumnDefinitions="380,*" ColumnSpacing="18">
              <StackPanel Spacing="14">
                <Border Classes="panel">
                  <StackPanel Spacing="10">
                    <TextBlock Classes="section-title" Text="Add an account" />
                    <TextBlock Text="Stagecoach uses Microsoft's own sign-in. It never asks for or stores your Microsoft password."
                               FontSize="{StaticResource StageFontSize12}" Opacity="0.8" TextWrapping="Wrap" />
                    <TextBox Text="{Binding NewIdentityName}" PlaceholderText="Friendly label — customer, employer, lab (optional)" />
                    <Button Classes="primary" Content="Sign in with Microsoft"
                            Command="{Binding AddWindowsAccountCommand}" IsEnabled="{Binding !IsBusy}"
                            HorizontalAlignment="Stretch"
                            AutomationProperties.Name="Sign in with a Microsoft Entra account" />
                    <Button Content="Sign in with a device code"
                            Command="{Binding AddDeviceCodeAccountCommand}" IsEnabled="{Binding !IsBusy}"
                            HorizontalAlignment="Stretch" />
                    <TextBlock TextWrapping="Wrap" FontSize="{StaticResource StageFontSize11}" Opacity="0.75"
                               Text="Your Windows sign-in does not have to be an Entra account — Microsoft's sign-in window lets you enter any work or school account. Choose device code when no sign-in window can be shown, such as over a remote session; the code appears in the status bar." />
                    <TextBlock Text="Conditional Access and MFA prompts still belong to Microsoft. Stagecoach never suppresses them."
                               FontSize="{StaticResource StageFontSize11}" Opacity="0.75" TextWrapping="Wrap" />
                  </StackPanel>
                </Border>

                <ListBox ItemsSource="{Binding Identities}" SelectedItem="{Binding SelectedIdentity}"
                         Background="Transparent" BorderThickness="0" MaxHeight="260"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         AutomationProperties.Name="Connected Entra accounts">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:IdentityRow">
                      <!-- Foreground is set explicitly on every line. Inheriting it let the theme's
                           white selected-row foreground blank the card out completely. -->
                      <Border Classes="card" Margin="0,0,0,8">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                          <StackPanel Spacing="2">
                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource StageColorInk}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding AccountName}"
                                       Foreground="{DynamicResource StageColorMuted}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding State}" FontSize="{StaticResource StageFontSize11}"
                                       Foreground="{DynamicResource StageColorMuted}" />
                          </StackPanel>
                          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Button Content="Reauth"
                                    Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).ReauthenticateCommand}"
                                    CommandParameter="{Binding}" />
                            <Button Content="Remove"
                                    Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).RemoveIdentityCommand}"
                                    CommandParameter="{Binding}" />
                          </StackPanel>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>

                <Border Classes="panel" IsVisible="{Binding SelectedIdentity, Converter={x:Static conv:ObjectConverters.IsNotNull}}">
                  <StackPanel Spacing="8">
                    <TextBlock Classes="section-title" Text="Rename this account" />
                    <TextBlock Text="Only the label Stagecoach shows. The Microsoft account is unchanged."
                               FontSize="{StaticResource StageFontSize11}" Opacity="0.75" TextWrapping="Wrap" />
                    <TextBox Text="{Binding RenameIdentityText}" PlaceholderText="Customer, employer, lab…" />
                    <Button Content="Save name" Command="{Binding RenameIdentityCommand}" HorizontalAlignment="Left" />
                  </StackPanel>
                </Border>
              </StackPanel>

              <StackPanel Grid.Column="1" Spacing="14">
                <Border Classes="panel">
                  <StackPanel Spacing="10">
                    <TextBlock Classes="section-title" Text="Scan scope and rescan" />
                    <TextBlock TextWrapping="Wrap" Opacity="0.75"
                               Text="Refresh available scope finds newly granted tenants and subscriptions. Rescan machines re-reads the estate inside the scope you already included." />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Button Content="↻  Refresh available scope" Command="{Binding RefreshIdentityScopeCommand}" />
                      <Button Classes="primary" Content="⌕  Rescan machines" Command="{Binding RescanIdentityCommand}" />
                    </StackPanel>
                  </StackPanel>
                </Border>

                <Border Classes="panel">
                  <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                      <TextBlock Classes="section-title" VerticalAlignment="Center"
                                 Text="{Binding Tenants.Count, StringFormat='Tenants ({0})'}" />
                      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                        <Button Content="Include all" Command="{Binding IncludeAllTenantsCommand}" />
                        <Button Content="Exclude all" Command="{Binding ExcludeAllTenantsCommand}" />
                      </StackPanel>
                    </Grid>
                    <!-- Fixed columns so the state and the action line up down the list, and an
                         always-visible scroll bar so a long list does not just look truncated. -->
                    <Grid ColumnDefinitions="*,90,130" Margin="10,0,22,0">
                      <TextBlock Classes="column-header" Text="TENANT" />
                      <TextBlock Grid.Column="1" Classes="column-header" Text="STATE" />
                      <TextBlock Grid.Column="2" Classes="column-header" Text="" />
                    </Grid>
                    <ListBox ItemsSource="{Binding Tenants}" MaxHeight="220" Background="Transparent" BorderThickness="0"
                             ScrollViewer.VerticalScrollBarVisibility="Visible"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             AutomationProperties.Name="Discovered tenants">
                      <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:TenantRow">
                          <Grid ColumnDefinitions="*,90,130" Margin="10,6" ColumnSpacing="8">
                            <StackPanel Spacing="1" VerticalAlignment="Center">
                              <TextBlock Text="{Binding DisplayName}" Foreground="{DynamicResource StageColorInk}"
                                         TextTrimming="CharacterEllipsis" />
                              <TextBlock Text="{Binding TenantId}" FontSize="10"
                                         Foreground="{DynamicResource StageColorMuted}"
                                         TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding Selection}" VerticalAlignment="Center"
                                       Foreground="{DynamicResource StageColorMuted}" />
                            <Button Grid.Column="2" Content="Include / exclude" HorizontalAlignment="Stretch"
                                    Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).ToggleTenantCommand}"
                                    CommandParameter="{Binding}" />
                          </Grid>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                  </StackPanel>
                </Border>

                <Border Classes="panel">
                  <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                      <TextBlock Classes="section-title" VerticalAlignment="Center"
                                 Text="{Binding Subscriptions.Count, StringFormat='Subscriptions ({0})'}" />
                      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                        <Button Content="Include all" Command="{Binding IncludeAllSubscriptionsCommand}" />
                        <Button Content="Exclude all" Command="{Binding ExcludeAllSubscriptionsCommand}" />
                      </StackPanel>
                    </Grid>
                    <Grid ColumnDefinitions="*,90,130" Margin="10,0,22,0">
                      <TextBlock Classes="column-header" Text="SUBSCRIPTION" />
                      <TextBlock Grid.Column="1" Classes="column-header" Text="STATE" />
                      <TextBlock Grid.Column="2" Classes="column-header" Text="" />
                    </Grid>
                    <ListBox ItemsSource="{Binding Subscriptions}" MaxHeight="300" Background="Transparent" BorderThickness="0"
                             ScrollViewer.VerticalScrollBarVisibility="Visible"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             AutomationProperties.Name="Discovered subscriptions">
                      <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:SubscriptionRow">
                          <Grid ColumnDefinitions="*,90,130" Margin="10,6" ColumnSpacing="8">
                            <StackPanel Spacing="1" VerticalAlignment="Center">
                              <TextBlock Text="{Binding DisplayName}" Foreground="{DynamicResource StageColorInk}"
                                         TextTrimming="CharacterEllipsis" />
                              <TextBlock Text="{Binding SubscriptionId}" FontSize="10"
                                         Foreground="{DynamicResource StageColorMuted}"
                                         TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding Selection}" VerticalAlignment="Center"
                                       Foreground="{DynamicResource StageColorMuted}" />
                            <Button Grid.Column="2" Content="Include / exclude" HorizontalAlignment="Stretch"
                                    Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).ToggleSubscriptionCommand}"
                                    CommandParameter="{Binding}" />
                          </Grid>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                  </StackPanel>
                </Border>
              </StackPanel>
            </Grid>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- ============================================================ LOCAL ACCOUNTS -->
      <TabItem Header="◉  Local accounts">
        <ScrollViewer>
          <StackPanel Margin="30,24,30,20" Spacing="14">
            <StackPanel Spacing="6">
              <TextBlock Classes="screen-eyebrow" Text="IN-GUEST SIGN-IN" />
              <TextBlock Classes="screen-title" Text="Local accounts" />
              <TextBlock Classes="screen-description"
                         Text="The accounts used inside the machines themselves. Use DOMAIN\username for a domain account, or just username for a local one. Passwords live in Windows Credential Manager and never in the Stagecoach database, logs, or command lines." />
            </StackPanel>

            <Grid ColumnDefinitions="400,*" ColumnSpacing="18">
              <Border Classes="panel">
                <StackPanel Spacing="10">
                  <TextBlock Classes="section-title" Text="Add or edit an account" />
                  <StackPanel Spacing="4">
                    <TextBlock Classes="field-label" Text="Display name" />
                    <TextBox Text="{Binding NewAccountName}" PlaceholderText="e.g. Prod local admin" />
                  </StackPanel>
                  <StackPanel Spacing="4">
                    <TextBlock Classes="field-label" Text="Username" />
                    <TextBox Text="{Binding NewAccountUsername}" PlaceholderText="DOMAIN\username  or  username" />
                  </StackPanel>
                  <StackPanel Spacing="4">
                    <TextBlock Classes="field-label" Text="Password" />
                    <TextBox Text="{Binding NewAccountPassword}" PasswordChar="●"
                             PlaceholderText="Stored in Windows Credential Manager" />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Classes="primary" Content="Save account" Command="{Binding SaveLocalAccountCommand}" />
                    <Button Content="Cancel edit" Command="{Binding CancelLocalAccountEditCommand}" />
                  </StackPanel>
                </StackPanel>
              </Border>

              <StackPanel Grid.Column="1" Spacing="10">
                <Border Classes="info" IsVisible="{Binding !HasLocalAccounts}">
                  <TextBlock TextWrapping="Wrap"
                             Text="No local accounts yet. Add one here, then pin it to machines with Edit on the Machines screen so connecting never asks." />
                </Border>
                <ListBox ItemsSource="{Binding LocalAccounts}" Background="Transparent" BorderThickness="0"
                         AutomationProperties.Name="Stored local accounts">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:LocalAccountRow">
                      <Border Classes="card" Margin="0,0,0,10">
                        <Grid ColumnDefinitions="*,Auto">
                          <StackPanel Spacing="3">
                            <TextBlock Text="{Binding DisplayName}" FontSize="{StaticResource StageFontSize18}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Username}" FontFamily="Consolas" />
                            <TextBlock Text="{Binding Kind}" Opacity="0.7" />
                            <TextBlock Text="{Binding Credential}" FontSize="{StaticResource StageFontSize11}" />
                          </StackPanel>
                          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Top">
                            <Button Content="Edit"
                                    Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).EditLocalAccountCommand}"
                                    CommandParameter="{Binding}" />
                            <Button Content="Remove"
                                    Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).RemoveLocalAccountCommand}"
                                    CommandParameter="{Binding}" />
                          </StackPanel>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </StackPanel>
            </Grid>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- ============================================================ SESSIONS -->
      <TabItem Header="⌁  Sessions">
        <ScrollViewer>
          <StackPanel Margin="30,24,30,20" Spacing="14">
            <StackPanel Spacing="6">
              <TextBlock Classes="screen-eyebrow" Text="RUNNING NOW" />
              <TextBlock Classes="screen-title" Text="Sessions" />
              <TextBlock Classes="screen-description"
                         Text="Managed Remote Desktop, SSH, Bastion, and Arc helper processes. Closing a client reaps its helper and returns its local port." />
            </StackPanel>
            <Border Classes="panel" Padding="0">
              <Grid RowDefinitions="Auto,*" MinWidth="700">
                <Grid Grid.Row="0" ColumnDefinitions="2*,160,140,170,100" Margin="8,8,8,6"
                      Background="{DynamicResource StageColorSurfaceAlt}">
                  <TextBlock Classes="column-header" Text="MACHINE" Margin="6,8" />
                  <TextBlock Grid.Column="1" Classes="column-header" Text="ROUTE" Margin="6,8" />
                  <TextBlock Grid.Column="2" Classes="column-header" Text="STATE" Margin="6,8" />
                  <TextBlock Grid.Column="3" Classes="column-header" Text="STARTED" Margin="6,8" />
                  <TextBlock Grid.Column="4" Classes="column-header" Text="" Margin="6,8" />
                </Grid>
                <ListBox Grid.Row="1" Classes="estate-list" ItemsSource="{Binding Sessions}" MinHeight="140"
                         AutomationProperties.Name="Active sessions">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:SessionRow">
                      <Grid ColumnDefinitions="2*,160,140,170,100" Margin="6,8">
                        <StackPanel Margin="6,0">
                          <TextBlock Text="{Binding Machine}" FontWeight="SemiBold" />
                          <TextBlock Text="{Binding Detail}" FontSize="{StaticResource StageFontSize11}" Opacity="0.7" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding Route}" VerticalAlignment="Center" Margin="6,0" />
                        <TextBlock Grid.Column="2" Text="{Binding State}" VerticalAlignment="Center" Margin="6,0" />
                        <TextBlock Grid.Column="3" Text="{Binding Started}" VerticalAlignment="Center" Margin="6,0" />
                        <Button Grid.Column="4" Content="Stop" Margin="6,0"
                                Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).StopSessionCommand}"
                                CommandParameter="{Binding}" />
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </Grid>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- ============================================================ SETTINGS -->
      <TabItem Header="⌸  Activity">
        <ScrollViewer>
          <StackPanel Margin="30,24,30,20" Spacing="14">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
              <StackPanel Spacing="6">
                <TextBlock Classes="screen-eyebrow" Text="AUDIT TRAIL" />
                <TextBlock Classes="screen-title" Text="Activity" />
                <TextBlock Classes="screen-description"
                           Text="What Stagecoach did and when: scans and what they found, connections, and changes to accounts and scope. Held in the encrypted local database, and never containing passwords, tokens, or resource identifiers." />
              </StackPanel>
              <Button Grid.Column="1" Content="↻  Refresh" VerticalAlignment="Center"
                      Command="{Binding RefreshAuditCommand}" />
            </Grid>

            <TextBlock Text="{Binding AuditStatus}" TextWrapping="Wrap" Margin="0,0,0,4"
                       Foreground="{DynamicResource StageColorDanger}"
                       IsVisible="{Binding AuditStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

            <Border Classes="panel" Padding="0">
              <Grid RowDefinitions="Auto,*" MinWidth="720">
                <Grid Grid.Row="0" ColumnDefinitions="170,110,2*,2*" Margin="8,8,8,6"
                      Background="{DynamicResource StageColorSurfaceAlt}">
                  <TextBlock Classes="column-header" Text="WHEN" Margin="6,8" />
                  <TextBlock Grid.Column="1" Classes="column-header" Text="AREA" Margin="6,8" />
                  <TextBlock Grid.Column="2" Classes="column-header" Text="ACTION" Margin="6,8" />
                  <TextBlock Grid.Column="3" Classes="column-header" Text="DETAIL" Margin="6,8" />
                </Grid>
                <ListBox Grid.Row="1" Classes="estate-list" ItemsSource="{Binding AuditEvents}"
                         MinHeight="160" MaxHeight="520"
                         ScrollViewer.VerticalScrollBarVisibility="Visible"
                         AutomationProperties.Name="Activity log">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:AuditRow">
                      <Grid ColumnDefinitions="170,110,2*,2*" Margin="6,6">
                        <TextBlock Text="{Binding When}" Margin="6,0" FontFamily="Consolas"
                                   Foreground="{DynamicResource StageColorMuted}" />
                        <TextBlock Grid.Column="1" Text="{Binding Category}" Margin="6,0"
                                   Foreground="{DynamicResource StageColorMuted}" />
                        <TextBlock Grid.Column="2" Text="{Binding Summary}" Margin="6,0"
                                   Foreground="{DynamicResource StageColorInk}" TextWrapping="Wrap" />
                        <TextBlock Grid.Column="3" Text="{Binding Detail}" Margin="6,0"
                                   Foreground="{DynamicResource StageColorMuted}" TextWrapping="Wrap" />
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </Grid>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="⚙  Settings">
        <ScrollViewer>
          <StackPanel Margin="30,24,30,20" Spacing="14" MaxWidth="820" HorizontalAlignment="Left">
            <StackPanel Spacing="6">
              <TextBlock Classes="screen-eyebrow" Text="THIS WINDOWS PROFILE" />
              <TextBlock Classes="screen-title" Text="Settings" />
              <TextBlock Classes="screen-description"
                         Text="Appearance, background behaviour, workstation prerequisites, and updates." />
            </StackPanel>

            <Border Classes="panel">
              <Grid ColumnDefinitions="230,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="12" ColumnSpacing="12">
                <TextBlock Text="Theme" VerticalAlignment="Center" />
                <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme}" />
                <TextBlock Grid.Row="1" Text="Accent color" VerticalAlignment="Center" />
                <ComboBox Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding Accents}" SelectedItem="{Binding SelectedAccent}" />
                <TextBlock Grid.Row="2" Text="Close behavior" VerticalAlignment="Center" />
                <ComboBox Grid.Row="2" Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding CloseBehaviors}" SelectedItem="{Binding SelectedCloseBehavior}" />
                <TextBlock Grid.Row="3" Text="Notification area" VerticalAlignment="Center" />
                <CheckBox Grid.Row="3" Grid.Column="1" IsChecked="{Binding MinimizeToNotificationArea}"
                          Content="Keep running in the notification area when minimized" />
                <TextBlock Grid.Row="4" Text="Background refresh" VerticalAlignment="Center" />
                <CheckBox Grid.Row="4" Grid.Column="1" IsChecked="{Binding BackgroundSyncEnabled}"
                          Content="Refresh estate metadata in the background" />
                <TextBlock Grid.Row="5" Text="Refresh interval (minutes)" VerticalAlignment="Center" />
                <NumericUpDown Grid.Row="5" Grid.Column="1" HorizontalAlignment="Left" MinWidth="160"
                               Value="{Binding BackgroundSyncMinutes}" Minimum="5" Maximum="1440" FormatString="0" />
              </Grid>
            </Border>

            <Border Classes="panel">
              <StackPanel Spacing="10">
                <TextBlock Classes="section-title" Text="Software updates" />
                <TextBlock Text="{Binding CurrentVersion, StringFormat='Installed version  {0}'}" Opacity="0.75" />
                <TextBlock Text="{Binding UpdateStatus}" TextWrapping="Wrap" />
                <Border Classes="info" IsVisible="{Binding AvailableUpdate, Converter={x:Static conv:ObjectConverters.IsNotNull}}">
                  <StackPanel Spacing="4">
                    <TextBlock Text="{Binding AvailableUpdate.ReleaseName}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding AvailableUpdate.ReleaseNotes}" TextWrapping="Wrap" MaxHeight="180" />
                  </StackPanel>
                </Border>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Content="Check for updates" Command="{Binding CheckForUpdateCommand}" />
                  <Button Content="Download and verify" Command="{Binding DownloadUpdateCommand}" />
                  <Button Classes="primary" Content="Install update"
                          Command="{Binding InstallUpdateCommand}" IsEnabled="{Binding IsUpdateReadyToInstall}" />
                </StackPanel>
                <TextBlock TextWrapping="Wrap" Opacity="0.75" FontSize="{StaticResource StageFontSize11}"
                           Text="Installing closes Stagecoach so Windows can replace it, then offers to start it again. Any running sessions end." />
                <TextBlock Text="Updates are only accepted from the signed Stagecoach release repository and are SHA-256 verified before Windows Installer runs."
                           FontSize="{StaticResource StageFontSize11}" Opacity="0.7" TextWrapping="Wrap" />
              </StackPanel>
            </Border>

            <Border Classes="panel">
              <StackPanel Spacing="10">
                <TextBlock Classes="section-title" Text="How your data is protected" />
                <TextBlock TextWrapping="Wrap" Opacity="0.85"
                           Text="Stagecoach has no sign-in of its own. Access to it is your Windows sign-in: everything it stores is encrypted with a key only your Windows account can unwrap, so another account on this machine cannot read it, and copying the files to another machine makes them useless." />
                <TextBlock TextWrapping="Wrap" Opacity="0.75" FontSize="{StaticResource StageFontSize11}"
                           Text="Estate metadata is held in a SQLCipher-encrypted database whose key is protected by Windows DPAPI for your user. Local account passwords are kept only in Windows Credential Manager. Azure tokens stay in each connected account's own isolated, Windows-encrypted Azure CLI cache. Connected Entra accounts are for discovering and reaching machines — they are not a login to Stagecoach." />
                <TextBlock TextWrapping="Wrap" Opacity="0.75" FontSize="{StaticResource StageFontSize11}"
                           Text="This does not protect against someone using your unlocked Windows session. Lock Windows when you step away." />
              </StackPanel>
            </Border>

            <Border Classes="panel">
              <StackPanel Spacing="10">
                <TextBlock Classes="section-title" Text="Support and diagnostics" />
                <TextBlock TextWrapping="Wrap" Opacity="0.8"
                           Text="Collects the error log, an environment summary, and a list of local file names into a single zip you can attach to a support request. It contains no passwords, no Azure tokens, and nothing from the metadata database or the Azure CLI profiles." />
                <TextBlock Text="{Binding SupportBundleStatus}" TextWrapping="Wrap" />
                <TextBox Text="{Binding LatestSupportBundlePath, Mode=OneWay}" IsReadOnly="True"
                         IsVisible="{Binding LatestSupportBundlePath, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                         AutomationProperties.Name="Most recent support bundle path" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Classes="primary" Content="Create support bundle" Command="{Binding CreateSupportBundleCommand}" />
                  <Button Content="Open support folder" Command="{Binding OpenSupportFolderCommand}" />
                </StackPanel>
              </StackPanel>
            </Border>

            <Border Classes="panel">
              <StackPanel Spacing="10">
                <TextBlock Classes="section-title" Text="Who owns this installation" />
                <TextBlock Text="{Binding OwnerStatus}" TextWrapping="Wrap" />
                <TextBlock TextWrapping="Wrap" Opacity="0.75" FontSize="{StaticResource StageFontSize11}"
                           Text="There is no Stagecoach passphrase. The local database is encrypted with a key protected by Windows for this Windows account, so it cannot be read by another account or moved to another machine, and opening Stagecoach requires a presence check first." />
              </StackPanel>
            </Border>

            <Border Classes="panel">
              <StackPanel Spacing="10">
                <TextBlock Classes="section-title" Text="Move settings to another machine" />
                <TextBlock TextWrapping="Wrap" Opacity="0.85"
                           Text="Exports your local account definitions, which account is pinned to which machine, and your preferences. Passwords, Azure tokens, and the database key are never included — they are tied to this Windows account and this machine deliberately. After importing, enter each password once and sign the Entra accounts in again." />
                <TextBox Text="{Binding PortablePath}" PlaceholderText="Path to a settings export file"
                         AutomationProperties.Name="Settings export path" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Classes="primary" Content="Export settings" Command="{Binding ExportSettingsCommand}" />
                  <Button Content="Import from path" Command="{Binding ImportSettingsCommand}" />
                </StackPanel>
              </StackPanel>
            </Border>

            <Border Classes="panel">
              <StackPanel Spacing="8">
                <TextBlock Classes="section-title" Text="Workstation readiness" />
                <TextBlock Text="{Binding WorkstationStatus}" TextWrapping="Wrap" />
                <Button Content="Install or update local Azure CLI extensions"
                        Command="{Binding PrepareWorkstationCommand}" HorizontalAlignment="Left" />
              </StackPanel>
            </Border>

            <Button Classes="primary" Content="Save settings" Command="{Binding SaveSettingsCommand}" HorizontalAlignment="Left" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- ============================================================ ABOUT -->
      <TabItem Header="ⓘ  About">
        <ScrollViewer>
          <StackPanel Margin="30,24,30,20" Spacing="14" MaxWidth="820" HorizontalAlignment="Left">
            <StackPanel Spacing="6">
              <TextBlock Classes="screen-eyebrow" Text="ABOUT" />
              <TextBlock Classes="screen-title" Text="Stagecoach" />
              <TextBlock Classes="screen-description"
                         Text="One identity hub. Every reachable machine. One click. A native Windows launcher for RDP and SSH to Azure VMs behind Bastion, Azure Arc-enabled servers, and Azure Local machines." />
            </StackPanel>

            <Border Classes="panel">
              <StackPanel Spacing="8">
                <TextBlock Text="{Binding CurrentVersion, StringFormat='Installed version  {0}'}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding UpdateStatus}" TextWrapping="Wrap" Opacity="0.8" />
                <Button Content="Check for updates" Command="{Binding CheckForUpdateCommand}" HorizontalAlignment="Left" />
              </StackPanel>
            </Border>

            <Border Classes="panel">
              <StackPanel Spacing="10">
                <TextBlock Classes="section-title" Text="Documentation and releases" />
                <StackPanel Spacing="3">
                  <TextBlock Text="Documentation" FontWeight="SemiBold" />
                  <SelectableTextBlock Text="https://labs.hybridsolutions.cloud/stagecoach/"
                                       Foreground="{DynamicResource StageColorAccentStrong}" />
                </StackPanel>
                <StackPanel Spacing="3">
                  <TextBlock Text="Release notes and downloads" FontWeight="SemiBold" />
                  <SelectableTextBlock Text="https://github.com/Hybrid-Solutions-Cloud/stagecoach/releases"
                                       Foreground="{DynamicResource StageColorAccentStrong}" />
                </StackPanel>
                <StackPanel Spacing="3">
                  <TextBlock Text="Roadmap" FontWeight="SemiBold" />
                  <SelectableTextBlock Text="https://labs.hybridsolutions.cloud/stagecoach/about/roadmap.html"
                                       Foreground="{DynamicResource StageColorAccentStrong}" />
                </StackPanel>
                <StackPanel Spacing="3">
                  <TextBlock Text="Report a problem" FontWeight="SemiBold" />
                  <SelectableTextBlock Text="https://github.com/Hybrid-Solutions-Cloud/stagecoach/issues"
                                       Foreground="{DynamicResource StageColorAccentStrong}" />
                </StackPanel>
              </StackPanel>
            </Border>

            <Border Classes="panel">
              <StackPanel Spacing="10">
                <TextBlock Classes="section-title" Text="Get support" />
                <TextBlock TextWrapping="Wrap"
                           Text="Create a support bundle and attach it to your report. It carries the error log, an environment summary, and a file listing — and no passwords, tokens, or estate data." />
                <TextBlock Text="{Binding SupportBundleStatus}" TextWrapping="Wrap" Opacity="0.8" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Classes="primary" Content="Create support bundle" Command="{Binding CreateSupportBundleCommand}" />
                  <Button Content="Open support folder" Command="{Binding OpenSupportFolderCommand}" />
                </StackPanel>
              </StackPanel>
            </Border>

            <Border Classes="panel">
              <StackPanel Spacing="6">
                <TextBlock Classes="section-title" Text="Licence" />
                <TextBlock TextWrapping="Wrap" Opacity="0.85"
                           Text="MIT. Copyright 2026 Kristopher Turner / Hybrid Cloud Solutions." />
                <TextBlock TextWrapping="Wrap" Opacity="0.75" FontSize="{StaticResource StageFontSize11}"
                           Text="Stagecoach uses the Azure access you already hold and grants none. Azure discovery is read-only; the only write it performs is an Arc OpenSSH deployment you explicitly approve." />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>

    <!-- Quick connect. Deliberately a throwaway path: nothing here is written to the store, so no
         identity, pin, scope selection, or estate row survives it. -->
    <Border Grid.Row="2" IsVisible="{Binding IsQuickConnectOpen}" Background="#B325231F">
      <Border Classes="panel" MaxWidth="720" MaxHeight="640" VerticalAlignment="Center" HorizontalAlignment="Center">
        <ScrollViewer>
          <StackPanel Spacing="12">
            <StackPanel Spacing="4">
              <TextBlock Classes="screen-eyebrow" Text="QUICK CONNECT" />
              <TextBlock Text="Reach a machine once" FontSize="{StaticResource StageFontSize20}" FontWeight="SemiBold" />
              <TextBlock TextWrapping="Wrap" Opacity="0.8" FontSize="{StaticResource StageFontSize12}"
                         Text="Nothing is saved: no account, no pin, no scope, no estate entry. Leave the subscription or the name empty to search wider." />
            </StackPanel>

            <!-- Signs in fresh for this one connection. No connected identity is created, and the
                 profile is deleted when the dialog closes. -->
            <Border Classes="callout">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <Button Classes="primary" Content="Sign in with Microsoft"
                        Command="{Binding QuickSignInCommand}" IsEnabled="{Binding !IsBusy}"
                        AutomationProperties.Name="Sign in for this connection only" />
                <TextBlock Text="{Binding QuickAccountName}" VerticalAlignment="Center" FontWeight="SemiBold"
                           IsVisible="{Binding QuickSignedIn}" />
              </StackPanel>
            </Border>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="10" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="10"
                  IsEnabled="{Binding QuickSignedIn}">
              <StackPanel Spacing="4">
                <TextBlock Classes="field-label" Text="Tenant" />
                <ComboBox HorizontalAlignment="Stretch" MinHeight="36"
                          ItemsSource="{Binding QuickTenants}" SelectedItem="{Binding QuickTenant}"
                          AutomationProperties.Name="Tenant" />
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="4">
                <TextBlock Classes="field-label" Text="Reached through" />
                <ComboBox HorizontalAlignment="Stretch" MinHeight="36"
                          ItemsSource="{Binding QuickRouteKinds}" SelectedItem="{Binding QuickRouteKind}"
                          AutomationProperties.Name="Bastion or Arc" />
              </StackPanel>

              <StackPanel Grid.Row="1" Spacing="4">
                <TextBlock Classes="field-label" Text="Subscription — optional" />
                <ComboBox HorizontalAlignment="Stretch" MinHeight="36"
                          ItemsSource="{Binding QuickSubscriptions}" SelectedItem="{Binding QuickSubscription}"
                          AutomationProperties.Name="Subscription, optional" />
              </StackPanel>
              <!-- Typed, never taken from the stored accounts: a quick connection uses nothing the
                   application has saved. Left empty for a machine that signs in with Entra. -->
              <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4">
                <TextBlock Classes="field-label" Text="In-guest account — optional" />
                <TextBox Text="{Binding QuickUsername}" MinHeight="36"
                         PlaceholderText="DOMAIN\username, or username"
                         AutomationProperties.Name="Account to use inside the machine" />
              </StackPanel>

              <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Spacing="4">
                <TextBlock Classes="field-label" Text="Password — only if an account was entered" />
                <TextBox Text="{Binding QuickPassword}" PasswordChar="●" MinHeight="36"
                         AutomationProperties.Name="Password for the in-guest account" />
                <TextBlock FontSize="{StaticResource StageFontSize11}" Opacity="0.75" TextWrapping="Wrap"
                           Text="Used once to launch this connection and then removed. It is never added to your saved accounts." />
              </StackPanel>

              <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Spacing="4">
                <TextBlock Classes="field-label" Text="Resource name — optional" />
                <TextBox Text="{Binding QuickResourceName}" MinHeight="36"
                         PlaceholderText="Leave empty to list everything"
                         AutomationProperties.Name="Resource name, optional" />
              </StackPanel>
            </Grid>

            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="⌕  Search" Command="{Binding QuickSearchCommand}" IsEnabled="{Binding !IsBusy}" />
              <TextBlock Text="{Binding QuickStatus}" VerticalAlignment="Center" TextWrapping="Wrap"
                         Foreground="{DynamicResource StageColorMuted}" MaxWidth="440" />
            </StackPanel>

            <Border Classes="panel" Padding="0" IsVisible="{Binding QuickResults.Count}">
              <ListBox Classes="estate-list" ItemsSource="{Binding QuickResults}" SelectedItem="{Binding QuickSelected}"
                       MaxHeight="220" ScrollViewer.VerticalScrollBarVisibility="Visible"
                       AutomationProperties.Name="Quick connect results">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:MachineRow">
                    <Grid ColumnDefinitions="2*,80,110,*" Margin="10,6" ColumnSpacing="8">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center"
                                 Foreground="{DynamicResource StageColorInk}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Column="1" Text="{Binding Source}" VerticalAlignment="Center"
                                 Foreground="{DynamicResource StageColorMuted}" />
                      <TextBlock Grid.Column="2" Text="{Binding Route}" VerticalAlignment="Center"
                                 Foreground="{DynamicResource StageColorMuted}" />
                      <TextBlock Grid.Column="3" Text="{Binding Subscription}" VerticalAlignment="Center"
                                 Foreground="{DynamicResource StageColorMuted}" TextTrimming="CharacterEllipsis" />
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Border>

            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Classes="primary" Content="Connect" Command="{Binding QuickConnectSelectedCommand}"
                      IsEnabled="{Binding !IsBusy}" />
              <Button Content="Cancel" Command="{Binding CancelQuickConnectCommand}" />
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Border>

    <Border Grid.Row="3" Background="{DynamicResource StageColorSurfaceAlt}"
            BorderThickness="0,1,0,0" BorderBrush="{DynamicResource StageColorLine}" Padding="18,9">
      <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
        <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        <TextBlock Grid.Column="1" VerticalAlignment="Center" FontWeight="SemiBold"
                   Text="{Binding ActiveSessionCount, StringFormat='{}{0} active'}" />
        <ProgressBar Grid.Column="2" Width="160" IsIndeterminate="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
      </Grid>
    </Border>
  </Grid>
</Window>
