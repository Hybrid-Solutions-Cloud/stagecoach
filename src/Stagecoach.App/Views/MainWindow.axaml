<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Stagecoach.App.ViewModels"
        xmlns:conv="using:Avalonia.Data.Converters"
        x:Class="Stagecoach.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Stagecoach"
        Width="1420" Height="900" MinWidth="1080" MinHeight="680"
        WindowStartupLocation="CenterScreen">
  <Grid RowDefinitions="Auto,*,Auto">
    <Border Grid.Row="0" Background="#17202A" Padding="22,15">
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="18">
        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
          <Border Width="38" Height="38" CornerRadius="19" Background="{DynamicResource StagecoachAccentBrush}">
            <TextBlock Text="S" FontSize="21" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel>
            <TextBlock Text="STAGECOACH" FontSize="18" FontWeight="SemiBold" Foreground="White" />
            <TextBlock Text="One identity hub. Every reachable machine. One click." FontSize="11" Foreground="#BFC9D4" />
          </StackPanel>
        </StackPanel>
        <TextBox Grid.Column="1" Text="{Binding SearchText}" PlaceholderText="Search machines, domains, resource groups, or subscriptions"
                 MaxWidth="620" HorizontalAlignment="Stretch" VerticalAlignment="Center" />
        <Button Grid.Column="2" Classes="primary" Command="{Binding SyncEstateCommand}" IsEnabled="{Binding !IsBusy}">
          <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="↻" /><TextBlock Text="Sync estate" /></StackPanel>
        </Button>
      </Grid>
    </Border>

    <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTabIndex}" TabStripPlacement="Left">
      <TabItem Header="Estate">
        <Grid Margin="22" RowDefinitions="Auto,*" RowSpacing="14">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <StackPanel>
              <TextBlock Text="Estate" FontSize="28" FontWeight="SemiBold" />
              <TextBlock Text="Every machine visible through your selected Entra identities." Opacity="0.7" />
            </StackPanel>
            <Border Grid.Column="1" Classes="card" Padding="14,8">
              <TextBlock Text="{Binding Machines.Count, StringFormat='{}{0} machines'}" VerticalAlignment="Center" />
            </Border>
          </Grid>
          <DataGrid Grid.Row="1" ItemsSource="{Binding Machines}" SelectedItem="{Binding SelectedMachine}"
                    AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal"
                    CanUserResizeColumns="True" HeadersVisibility="Column">
            <DataGrid.Columns>
              <DataGridTemplateColumn Header="" Width="42">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:MachineRow">
                    <Button Content="{Binding Favorite}" Padding="6" Command="{Binding $parent[Window].DataContext.ToggleFavoriteCommand}" CommandParameter="{Binding}" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Header="Machine" Binding="{Binding Name}" Width="2*" />
              <DataGridTextColumn Header="Type" Binding="{Binding Kind}" Width="110" />
              <DataGridTextColumn Header="OS" Binding="{Binding OperatingSystem}" Width="90" />
              <DataGridTextColumn Header="Environment" Binding="{Binding Environment}" Width="150" />
              <DataGridTextColumn Header="State" Binding="{Binding State}" Width="140" />
              <DataGridTemplateColumn Header="Connection route" Width="230">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:MachineRow">
                    <ComboBox ItemsSource="{Binding Paths}" SelectedItem="{Binding SelectedRoute}" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Header="Readiness" Binding="{Binding Readiness}" Width="135" />
              <DataGridTemplateColumn Header="" Width="190">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:MachineRow">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                      <Button Classes="primary" Content="Connect" Command="{Binding $parent[Window].DataContext.ConnectCommand}" CommandParameter="{Binding}" />
                      <Button Content="Prepare Arc" Command="{Binding $parent[Window].DataContext.PreviewArcRemediationCommand}" CommandParameter="{Binding}" />
                    </StackPanel>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </TabItem>

      <TabItem Header="Identities &amp; scope">
        <Grid Margin="22" ColumnDefinitions="360,*" ColumnSpacing="18">
          <StackPanel Spacing="14">
            <StackPanel>
              <TextBlock Text="Entra identities" FontSize="26" FontWeight="SemiBold" />
              <TextBlock Text="Each account has an isolated, Windows-encrypted Azure CLI session." TextWrapping="Wrap" Opacity="0.7" />
            </StackPanel>
            <Border Classes="card">
              <StackPanel Spacing="10">
                <TextBlock Text="Add an identity" FontWeight="SemiBold" />
                <TextBox Text="{Binding NewIdentityName}" PlaceholderText="Friendly name (optional)" />
                <Button Classes="primary" Content="Use my Windows account / choose account" Command="{Binding AddWindowsAccountCommand}" />
                <Button Content="Use device code instead" Command="{Binding AddDeviceCodeAccountCommand}" />
              </StackPanel>
            </Border>
            <ListBox ItemsSource="{Binding Identities}" SelectedItem="{Binding SelectedIdentity}">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:IdentityRow">
                  <Border Classes="card" Margin="0,0,0,8">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel><TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" /><TextBlock Text="{Binding AccountName}" Opacity="0.7" /><TextBlock Text="{Binding State}" FontSize="11" /></StackPanel>
                      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5">
                        <Button Content="Reauth" Command="{Binding $parent[Window].DataContext.ReauthenticateCommand}" CommandParameter="{Binding}" />
                        <Button Content="Remove" Command="{Binding $parent[Window].DataContext.RemoveIdentityCommand}" CommandParameter="{Binding}" />
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </StackPanel>

          <Grid Grid.Column="1" RowDefinitions="Auto,*,*" RowSpacing="14">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel><TextBlock Text="Selected scan scope" FontSize="22" FontWeight="SemiBold" /><TextBlock Text="New scope stays excluded until you include it." Opacity="0.7" /></StackPanel>
              <Button Grid.Column="1" Content="Refresh available scope" Command="{Binding RefreshIdentityScopeCommand}" />
            </Grid>
            <Border Grid.Row="1" Classes="card">
              <Grid RowDefinitions="Auto,*" RowSpacing="8">
                <TextBlock Text="Tenants" FontWeight="SemiBold" />
                <ListBox Grid.Row="1" ItemsSource="{Binding Tenants}">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:TenantRow">
                      <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,5">
                        <StackPanel><TextBlock Text="{Binding DisplayName}" /><TextBlock Text="{Binding TenantId}" FontSize="10" Opacity="0.55" /></StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding Selection}" VerticalAlignment="Center" Margin="12,0" />
                        <Button Grid.Column="2" Content="Include / exclude" Command="{Binding $parent[Window].DataContext.ToggleTenantCommand}" CommandParameter="{Binding}" />
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </Grid>
            </Border>
            <Border Grid.Row="2" Classes="card">
              <Grid RowDefinitions="Auto,*" RowSpacing="8">
                <TextBlock Text="Subscriptions" FontWeight="SemiBold" />
                <ListBox Grid.Row="1" ItemsSource="{Binding Subscriptions}">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:SubscriptionRow">
                      <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,5">
                        <StackPanel><TextBlock Text="{Binding DisplayName}" /><TextBlock Text="{Binding SubscriptionId}" FontSize="10" Opacity="0.55" /></StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding Selection}" VerticalAlignment="Center" Margin="12,0" />
                        <Button Grid.Column="2" Content="Include / exclude" Command="{Binding $parent[Window].DataContext.ToggleSubscriptionCommand}" CommandParameter="{Binding}" />
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </Grid>
            </Border>
          </Grid>
        </Grid>
      </TabItem>

      <TabItem Header="Connection identities">
        <Grid Margin="22" ColumnDefinitions="420,*" ColumnSpacing="18">
          <StackPanel Spacing="14">
            <StackPanel><TextBlock Text="Connection identities" FontSize="26" FontWeight="SemiBold" /><TextBlock Text="Domain and local accounts used inside target machines." Opacity="0.7" /></StackPanel>
            <Border Classes="card">
              <StackPanel Spacing="9">
                <TextBlock Text="Create identity" FontWeight="SemiBold" />
                <TextBox Text="{Binding NewConnectionName}" PlaceholderText="Friendly name, e.g. Corp production admin" />
                <ComboBox ItemsSource="{Binding ConnectionIdentityKinds}" SelectedItem="{Binding NewConnectionKind}" />
                <TextBox Text="{Binding NewConnectionUsername}" PlaceholderText="DOMAIN\username or .\username" />
                <TextBox Text="{Binding NewConnectionPassword}" PasswordChar="●" PlaceholderText="Password (stored in Windows Credential Manager)" />
                <TextBox Text="{Binding NewConnectionSshKeyPath}" PlaceholderText="SSH private key path (optional)" />
                <Button Classes="primary" Content="Save connection identity" Command="{Binding SaveConnectionIdentityCommand}" />
                <Button Content="Cancel edit" Command="{Binding CancelConnectionIdentityEditCommand}" />
              </StackPanel>
            </Border>
            <Border Classes="card">
              <StackPanel Spacing="9">
                <TextBlock Text="Map selected identity" FontWeight="SemiBold" />
                <TextBlock Text="Most-specific wins: machine, tag, domain, resource group, subscription, tenant." FontSize="11" TextWrapping="Wrap" Opacity="0.7" />
                <ComboBox ItemsSource="{Binding MappingKinds}" SelectedItem="{Binding NewMappingKind}" />
                <TextBox Text="{Binding NewMappingValue}" PlaceholderText="Match value (tag format: key=value)" />
                <NumericUpDown Value="{Binding NewMappingPriority}" Minimum="-1000" Maximum="1000" FormatString="0" />
                <CheckBox Content="Use as the Arc SSH relay identity" IsChecked="{Binding NewMappingIsRelay}" />
                <Button Content="Save mapping" Command="{Binding SaveMappingCommand}" />
              </StackPanel>
            </Border>
          </StackPanel>
          <Grid Grid.Column="1" RowDefinitions="*,Auto,*" RowSpacing="14">
            <ListBox ItemsSource="{Binding ConnectionIdentities}" SelectedItem="{Binding SelectedConnectionIdentity}">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:ConnectionIdentityRow">
                  <Border Classes="card" Margin="0,0,0,10">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel Spacing="3"><TextBlock Text="{Binding DisplayName}" FontSize="17" FontWeight="SemiBold" /><TextBlock Text="{Binding Username}" /><TextBlock Text="{Binding Kind}" Opacity="0.7" /><TextBlock Text="{Binding Credential}" FontSize="11" /></StackPanel>
                      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5" VerticalAlignment="Top"><Button Content="Edit" Command="{Binding $parent[Window].DataContext.EditConnectionIdentityCommand}" CommandParameter="{Binding}" /><Button Content="Remove" Command="{Binding $parent[Window].DataContext.RemoveConnectionIdentityCommand}" CommandParameter="{Binding}" /></StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock Grid.Row="1" Text="Mappings" FontSize="18" FontWeight="SemiBold" />
            <DataGrid Grid.Row="2" ItemsSource="{Binding ConnectionMappings}" AutoGenerateColumns="False" IsReadOnly="True">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Identity" Binding="{Binding IdentityName}" Width="2*" />
                <DataGridTextColumn Header="Purpose" Binding="{Binding Purpose}" Width="110" />
                <DataGridTextColumn Header="Scope" Binding="{Binding Scope}" Width="120" />
                <DataGridTextColumn Header="Match" Binding="{Binding Match}" Width="2*" />
                <DataGridTextColumn Header="Priority" Binding="{Binding Priority}" Width="80" />
                <DataGridTemplateColumn Header="" Width="90"><DataGridTemplateColumn.CellTemplate><DataTemplate x:DataType="vm:ConnectionMappingRow"><Button Content="Remove" Command="{Binding $parent[Window].DataContext.RemoveMappingCommand}" CommandParameter="{Binding}" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
              </DataGrid.Columns>
            </DataGrid>
          </Grid>
        </Grid>
      </TabItem>

      <TabItem Header="Sessions">
        <Grid Margin="22" RowDefinitions="Auto,*" RowSpacing="14">
          <StackPanel><TextBlock Text="Sessions" FontSize="26" FontWeight="SemiBold" /><TextBlock Text="Managed RDP, SSH, Bastion, and Arc helpers." Opacity="0.7" /></StackPanel>
          <DataGrid Grid.Row="1" ItemsSource="{Binding Sessions}" AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Machine" Binding="{Binding Machine}" Width="2*" />
              <DataGridTextColumn Header="Route" Binding="{Binding Route}" Width="180" />
              <DataGridTextColumn Header="State" Binding="{Binding State}" Width="140" />
              <DataGridTextColumn Header="Started" Binding="{Binding Started}" Width="180" />
              <DataGridTemplateColumn Header="" Width="100"><DataGridTemplateColumn.CellTemplate><DataTemplate x:DataType="vm:SessionRow"><Button Content="Stop" Command="{Binding $parent[Window].DataContext.StopSessionCommand}" CommandParameter="{Binding}" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </TabItem>

      <TabItem Header="Settings">
        <ScrollViewer>
          <StackPanel Margin="22" Spacing="16" MaxWidth="760" HorizontalAlignment="Left">
            <StackPanel><TextBlock Text="Settings" FontSize="26" FontWeight="SemiBold" /><TextBlock Text="Appearance and background behavior for this Windows profile." Opacity="0.7" /></StackPanel>
            <Border Classes="card"><Grid ColumnDefinitions="220,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="12"><TextBlock Text="Theme" /><ComboBox Grid.Column="1" ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme}" /><TextBlock Grid.Row="1" Text="Accent color" /><ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Accents}" SelectedItem="{Binding SelectedAccent}" /><TextBlock Grid.Row="2" Text="Close behavior" /><ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding CloseBehaviors}" SelectedItem="{Binding SelectedCloseBehavior}" /><TextBlock Grid.Row="3" Text="Notification area" /><CheckBox Grid.Row="3" Grid.Column="1" Content="Hide when minimized" IsChecked="{Binding MinimizeToNotificationArea}" /><TextBlock Grid.Row="4" Text="Background" /><CheckBox Grid.Row="4" Grid.Column="1" Content="Refresh metadata in the background" IsChecked="{Binding BackgroundSyncEnabled}" /><TextBlock Grid.Row="5" Text="Refresh interval (minutes)" /><NumericUpDown Grid.Row="5" Grid.Column="1" Value="{Binding BackgroundSyncMinutes}" Minimum="5" Maximum="1440" FormatString="0" /></Grid></Border>
            <Border Classes="card"><StackPanel Spacing="8"><TextBlock Text="Workstation readiness" FontWeight="SemiBold" /><TextBlock Text="{Binding WorkstationStatus}" TextWrapping="Wrap" /><Button Content="Install / update local CLI extensions" Command="{Binding PrepareWorkstationCommand}" HorizontalAlignment="Left" /></StackPanel></Border>
            <Border Classes="card" IsVisible="{Binding PendingRemediation, Converter={x:Static conv:ObjectConverters.IsNotNull}}"><StackPanel Spacing="8"><TextBlock Text="Pending Azure write" FontSize="18" FontWeight="SemiBold" /><TextBlock Text="{Binding PendingRemediation.Title}" FontWeight="SemiBold" /><TextBlock Text="{Binding PendingRemediation.Description}" TextWrapping="Wrap" /><TextBlock Text="Creates/updates only: Microsoft.Azure.OpenSSH / WindowsOpenSSH" TextWrapping="Wrap" /><StackPanel Orientation="Horizontal" Spacing="8"><Button Classes="primary" Content="Apply approved change" Command="{Binding ApplyArcRemediationCommand}" /><Button Content="Cancel" Command="{Binding CancelRemediationCommand}" /></StackPanel></StackPanel></Border>
            <Button Classes="primary" Content="Save settings" Command="{Binding SaveSettingsCommand}" HorizontalAlignment="Left" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>

    <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Padding="18,9">
      <Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding StatusMessage}" /><ProgressBar Grid.Column="1" Width="160" IsIndeterminate="{Binding IsBusy}" IsVisible="{Binding IsBusy}" /></Grid>
    </Border>
  </Grid>
</Window>
