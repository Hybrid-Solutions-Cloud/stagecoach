<Project Sdk="WixToolset.Sdk/5.0.2">
  <PropertyGroup>
    <OutputType>Package</OutputType>
    <InstallerPlatform>x64</InstallerPlatform>
    <OutputName>Stagecoach-$(ReleaseVersion)-win-x64</OutputName>
    <DefineConstants>ReleaseVersion=$(ReleaseVersion);MsiVersion=$(MsiVersion);PublishDirectory=$(PublishDirectory)</DefineConstants>
  </PropertyGroup>
</Project>
